DATABASE_URL=postgresql://localhost:5432/vice_tracker
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Auth (required for password/JWT auth) ────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate_a_long_random_secret_here
APP_URL=https://your-app-domain.com
# Comma-separated list of allowed CORS origins. Falls back to APP_URL if not set.
# Example: ALLOWED_ORIGINS=https://your-app-domain.com,https://www.your-app-domain.com
ALLOWED_ORIGINS=https://your-app-domain.com

# ── Email (for magic links & forgot password) ────────
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Vice to Value" <you@gmail.com>

# ── Optional features ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PLAID_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
PLAID_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PLAID_ENV=sandbox
VAPID_PUBLIC_KEY=generate_with__node_-e_webpush.generateVAPIDKeys()
VAPID_PRIVATE_KEY=generate_with__node_-e_webpush.generateVAPIDKeys()
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=generate_a_random_secret_string
ADMIN_SECRET=generate_a_random_secret_string

# ── Stripe (Pro subscription) ─────────────────────────
# Use a restricted key (rk_...) scoped to Checkout Sessions + Customers, not the full secret key.
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The one monthly recurring price for Pro.
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
# Signing secret for the endpoint POST /api/stripe/webhook (Dashboard > Developers > Webhooks,
# or `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Pro allowlist (owner override, no Stripe needed) ──
# Comma-separated emails treated as Pro regardless of Stripe status.
# Leave unset to gate Pro on Stripe only. Read by server/lib/entitlements.js.
PRO_ALLOWLIST_EMAILS=owner@example.com
